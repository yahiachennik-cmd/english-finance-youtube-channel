    {"text": "and *only if* the company grew.", "visual": "keep"},
    {"text": "*12 targets.* From $100B to *$650B* in value.",
     "visual": {"type": "bars", "bars": [
       {"label": "1", "value": 100, "display": "$100B"},
       {"label": "", "value": 150, "display": ""}, {"label": "", "value": 200, "display": ""},
       {"label": "", "value": 250, "display": ""}, {"label": "", "value": 300, "display": ""},
       {"label": "", "value": 350, "display": ""}, {"label": "", "value": 400, "display": ""},
       {"label": "", "value": 450, "display": ""}, {"label": "", "value": 500, "display": ""},
       {"label": "", "value": 550, "display": ""}, {"label": "", "value": 600, "display": ""},
       {"label": "12", "value": 650, "display": "$650B", "at": "650b"}]}},
    {"text": "Most people called it *impossible.*",
     "visual": {"type": "icon", "icon": "Ban"}},
    {"text": "Tesla hit *every single one.*",
